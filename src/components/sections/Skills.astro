---
interface Skill {
    name: string;
    value: number;
    color?: "cyan" | "purple" | "green";
}

const technicalSkills: Skill[] = [
    { name: "Python", value: 88, color: "purple" },
    { name: "JavaScript", value: 90, color: "cyan" },
    { name: "React", value: 86, color: "cyan" },
    { name: "Next.js", value: 85, color: "green" },
    { name: "TypeScript", value: 87, color: "cyan" },
];

const softSkills: Skill[] = [
    { name: "Logical Thinking", value: 92, color: "purple" },
    { name: "Problem Solving", value: 94, color: "cyan" },
    { name: "Quick Learning", value: 90, color: "green" },
    { name: "Communication", value: 88, color: "purple" },
];
---

<section class="capabilities-section" id="capabilities">
    <div class="section-header">
        <div class="header-line"></div>
        <div class="header-content">
            <span class="header-indicator"></span>
            <span class="header-label">CAPABILITIES.SYS</span>
        </div>
        <div class="header-line"></div>
    </div>

    <h2 class="section-title">System Capabilities</h2>

    <div class="capabilities-grid">
        <div class="capability-panel floating-panel">
            <div class="panel-header">
                <span class="panel-indicator cyan"></span>
                <span class="panel-title">Technical Subsystems</span>
            </div>
            <div class="skills-list">
                {
                    technicalSkills.map((skill, index) => (
                        <div
                            class={`skill-row ${skill.color}`}
                            style={`--delay: ${index * 0.1}s`}
                        >
                            <div class="skill-info">
                                <span class="skill-name">{skill.name}</span>
                                <span class="skill-percent">
                                    {skill.value}%
                                </span>
                            </div>
                            <div class="skill-bar-track">
                                <div
                                    class="skill-bar-fill"
                                    style={`--target-width: ${skill.value}%`}
                                >
                                    <div class="bar-glow" />
                                </div>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>

        <div class="capability-panel floating-panel">
            <div class="panel-header">
                <span class="panel-indicator purple"></span>
                <span class="panel-title">Core Operations</span>
            </div>
            <div class="skills-list">
                {
                    softSkills.map((skill, index) => (
                        <div
                            class={`skill-row ${skill.color}`}
                            style={`--delay: ${(index + technicalSkills.length) * 0.1}s`}
                        >
                            <div class="skill-info">
                                <span class="skill-name">{skill.name}</span>
                                <span class="skill-percent">
                                    {skill.value}%
                                </span>
                            </div>
                            <div class="skill-bar-track">
                                <div
                                    class="skill-bar-fill"
                                    style={`--target-width: ${skill.value}%`}
                                >
                                    <div class="bar-glow" />
                                </div>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</section>

<style>
    .capabilities-section {
        padding: 80px 20px;
        max-width: 1100px;
        margin: 0 auto;
        opacity: 0;
        transform: translateY(30px);
        transition:
            opacity var(--duration-slow) var(--ease-cinematic),
            transform var(--duration-slow) var(--ease-cinematic);
    }

    .capabilities-section.visible {
        opacity: 1;
        transform: translateY(0);
    }

    .section-header {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 20px;
        margin-bottom: 24px;
    }

    .header-line {
        flex: 1;
        max-width: 120px;
        height: 1px;
        background: linear-gradient(
            90deg,
            transparent,
            var(--border-default),
            transparent
        );
    }

    .header-content {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .header-indicator {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--ion-purple);
        box-shadow: 0 0 12px var(--ion-purple);
        animation: indicatorPulse 2s ease-in-out infinite;
    }

    @keyframes indicatorPulse {
        0%,
        100% {
            opacity: 1;
        }
        50% {
            opacity: 0.5;
        }
    }

    .header-label {
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 2px;
        color: var(--text-muted);
    }

    .section-title {
        font-family: var(--font-display);
        font-size: 32px;
        font-weight: 600;
        letter-spacing: 1px;
        color: var(--text-primary);
        text-align: center;
        margin-bottom: 48px;
    }

    .capabilities-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
        gap: 24px;
    }

    .capability-panel {
        padding: 0;
        overflow: hidden;
    }

    .panel-header {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 16px 24px;
        background: rgba(0, 0, 0, 0.3);
        border-bottom: 1px solid var(--border-default);
    }

    .panel-indicator {
        width: 8px;
        height: 8px;
        border-radius: 50%;
    }

    .panel-indicator.cyan {
        background: var(--neon-cyan);
        box-shadow: 0 0 10px var(--neon-cyan);
    }

    .panel-indicator.purple {
        background: var(--ion-purple);
        box-shadow: 0 0 10px var(--ion-purple);
    }

    .panel-title {
        font-family: var(--font-mono);
        font-size: 12px;
        letter-spacing: 1px;
        color: var(--text-secondary);
    }

    .skills-list {
        padding: 24px;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .skill-row {
        opacity: 0;
        animation: skillFadeIn 0.5s var(--ease-cinematic) forwards;
        animation-delay: var(--delay);
    }

    @keyframes skillFadeIn {
        to {
            opacity: 1;
        }
    }

    .skill-info {
        display: flex;
        justify-content: space-between;
        margin-bottom: 8px;
    }

    .skill-name {
        font-family: var(--font-primary);
        font-size: 14px;
        font-weight: 500;
        color: var(--text-primary);
    }

    .skill-percent {
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--text-muted);
    }

    .skill-bar-track {
        height: 6px;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 3px;
        overflow: hidden;
        position: relative;
    }

    .skill-bar-fill {
        height: 100%;
        width: 0;
        border-radius: 3px;
        position: relative;
        transition: width 1.2s var(--ease-cinematic);
        transition-delay: var(--delay);
    }

    .capabilities-section.visible .skill-bar-fill {
        width: var(--target-width);
    }

    .skill-row.cyan .skill-bar-fill {
        background: linear-gradient(
            90deg,
            var(--neon-cyan),
            var(--plasma-green)
        );
        box-shadow: 0 0 15px var(--glow-cyan);
    }

    .skill-row.purple .skill-bar-fill {
        background: linear-gradient(90deg, var(--ion-purple), #c084fc);
        box-shadow: 0 0 15px var(--glow-purple);
    }

    .skill-row.green .skill-bar-fill {
        background: linear-gradient(90deg, var(--plasma-green), #4ade80);
        box-shadow: 0 0 15px var(--glow-green);
    }

    .bar-glow {
        position: absolute;
        right: 0;
        top: 50%;
        transform: translateY(-50%);
        width: 20px;
        height: 20px;
        background: inherit;
        filter: blur(8px);
        opacity: 0.8;
    }

    @media (max-width: 768px) {
        .capabilities-grid {
            grid-template-columns: 1fr;
        }

        .section-title {
            font-size: 26px;
        }
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const section = document.querySelector(".capabilities-section");

        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add("visible");
                    }
                });
            },
            { threshold: 0.1 },
        );

        if (section) observer.observe(section);
    });
</script>
