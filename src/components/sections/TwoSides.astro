---
// Dual Operations - Holographic Split Panels
---

<section class="dual-ops-section" id="dual-ops">
    <div class="section-header">
        <div class="header-line"></div>
        <div class="header-content">
            <span class="header-indicator"></span>
            <span class="header-label">DUAL.OPS</span>
        </div>
        <div class="header-line"></div>
    </div>

    <h2 class="section-title">Operational Modes</h2>

    <div class="ops-container">
        <!-- Developer Mode Panel -->
        <div class="ops-panel floating-panel dev-panel">
            <div class="panel-glow cyan"></div>
            <div class="panel-header">
                <span class="mode-indicator cyan"></span>
                <span class="mode-label">MODE.A</span>
            </div>
            <div class="panel-content">
                <div class="mode-icon">
                    <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                    >
                        <polyline points="16,18 22,12 16,6"></polyline>
                        <polyline points="8,6 2,12 8,18"></polyline>
                    </svg>
                    <div class="icon-glow"></div>
                </div>
                <h3 class="mode-title">DEVELOPER</h3>
                <p class="mode-desc">Building systems & solving problems</p>

                <div class="mode-metrics">
                    <div class="metric-row">
                        <span class="metric-label">Stack</span>
                        <span class="metric-value">Full Stack</span>
                    </div>
                    <div class="metric-row">
                        <span class="metric-label">Focus</span>
                        <span class="metric-value">Performance</span>
                    </div>
                    <div class="metric-row">
                        <span class="metric-label">Output</span>
                        <span class="metric-value">Clean Code</span>
                    </div>
                </div>

                <a
                    href="https://leetcode.com/YOUR_USERNAME"
                    class="mode-link"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <span class="link-glow"></span>
                    VIEW.LEETCODE →
                </a>
            </div>
        </div>

        <!-- Energy Connection -->
        <div class="ops-connector">
            <div class="connector-beam"></div>
            <div class="connector-pulse"></div>
            <span class="connector-label">SYNC</span>
        </div>

        <!-- Creator Mode Panel -->
        <div class="ops-panel floating-panel creator-panel">
            <div class="panel-glow purple"></div>
            <div class="panel-header">
                <span class="mode-indicator purple"></span>
                <span class="mode-label">MODE.B</span>
            </div>
            <div class="panel-content">
                <div class="mode-icon purple">
                    <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                    >
                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"
                        ></rect>
                        <circle cx="8.5" cy="8.5" r="1.5"></circle>
                        <polyline points="21,15 16,10 5,21"></polyline>
                    </svg>
                    <div class="icon-glow"></div>
                </div>
                <h3 class="mode-title">CREATOR</h3>
                <p class="mode-desc">Crafting content & stories</p>

                <div class="mode-metrics">
                    <div class="metric-row">
                        <span class="metric-label">Focus</span>
                        <span class="metric-value">Content</span>
                    </div>
                    <div class="metric-row">
                        <span class="metric-label">Medium</span>
                        <span class="metric-value">Visual</span>
                    </div>
                    <div class="metric-row">
                        <span class="metric-label">Output</span>
                        <span class="metric-value">Engaging</span>
                    </div>
                </div>

                <a
                    href="https://instagram.com/YOUR_HANDLE"
                    class="mode-link purple"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <span class="link-glow"></span>
                    VIEW.INSTAGRAM →
                </a>
            </div>
        </div>
    </div>
</section>

<style>
    .dual-ops-section {
        padding: 80px 20px;
        max-width: 1100px;
        margin: 0 auto;
        opacity: 0;
        transform: translateY(30px);
        transition:
            opacity var(--duration-slow) var(--ease-cinematic),
            transform var(--duration-slow) var(--ease-cinematic);
    }

    .dual-ops-section.visible {
        opacity: 1;
        transform: translateY(0);
    }

    .section-header {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 20px;
        margin-bottom: 24px;
    }

    .header-line {
        flex: 1;
        max-width: 120px;
        height: 1px;
        background: linear-gradient(
            90deg,
            transparent,
            var(--border-default),
            transparent
        );
    }

    .header-content {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .header-indicator {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: linear-gradient(
            135deg,
            var(--neon-cyan),
            var(--ion-purple)
        );
        box-shadow: 0 0 12px var(--glow-cyan);
        animation: indicatorPulse 2s ease-in-out infinite;
    }

    @keyframes indicatorPulse {
        0%,
        100% {
            opacity: 1;
        }
        50% {
            opacity: 0.5;
        }
    }

    .header-label {
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 2px;
        color: var(--text-muted);
    }

    .section-title {
        font-family: var(--font-display);
        font-size: 32px;
        font-weight: 600;
        letter-spacing: 1px;
        color: var(--text-primary);
        text-align: center;
        margin-bottom: 48px;
    }

    .ops-container {
        display: flex;
        align-items: stretch;
        gap: 24px;
    }

    .ops-panel {
        flex: 1;
        padding: 0;
        overflow: hidden;
        position: relative;
    }

    .panel-glow {
        position: absolute;
        top: -50%;
        left: 50%;
        transform: translateX(-50%);
        width: 200px;
        height: 200px;
        border-radius: 50%;
        filter: blur(60px);
        opacity: 0.15;
        pointer-events: none;
        transition: opacity var(--duration-medium) ease;
    }

    .panel-glow.cyan {
        background: var(--neon-cyan);
    }

    .panel-glow.purple {
        background: var(--ion-purple);
    }

    .ops-panel:hover .panel-glow {
        opacity: 0.25;
    }

    .panel-header {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 14px 24px;
        background: rgba(0, 0, 0, 0.3);
        border-bottom: 1px solid var(--border-default);
    }

    .mode-indicator {
        width: 8px;
        height: 8px;
        border-radius: 50%;
    }

    .mode-indicator.cyan {
        background: var(--neon-cyan);
        box-shadow: 0 0 10px var(--neon-cyan);
    }

    .mode-indicator.purple {
        background: var(--ion-purple);
        box-shadow: 0 0 10px var(--ion-purple);
    }

    .mode-label {
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 1px;
        color: var(--text-muted);
    }

    .panel-content {
        padding: 32px 28px;
        text-align: center;
    }

    .mode-icon {
        width: 56px;
        height: 56px;
        margin: 0 auto 24px;
        color: var(--neon-cyan);
        position: relative;
    }

    .mode-icon.purple {
        color: var(--ion-purple);
    }

    .icon-glow {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: currentColor;
        filter: blur(25px);
        opacity: 0.2;
    }

    .mode-title {
        font-family: var(--font-display);
        font-size: 22px;
        font-weight: 600;
        letter-spacing: 3px;
        color: var(--text-primary);
        margin-bottom: 8px;
    }

    .mode-desc {
        font-size: 14px;
        color: var(--text-secondary);
        margin-bottom: 28px;
    }

    .mode-metrics {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-bottom: 28px;
    }

    .metric-row {
        display: flex;
        justify-content: space-between;
        padding: 10px 16px;
        background: rgba(0, 0, 0, 0.25);
        border-radius: 8px;
        border: 1px solid var(--border-default);
    }

    .metric-label {
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--text-muted);
    }

    .metric-value {
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--text-primary);
    }

    .mode-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-family: var(--font-mono);
        font-size: 12px;
        letter-spacing: 1px;
        color: var(--neon-cyan);
        text-decoration: none;
        padding: 12px 24px;
        border: 1px solid rgba(0, 240, 255, 0.3);
        border-radius: 8px;
        position: relative;
        overflow: hidden;
        transition: all var(--duration-medium) var(--ease-cinematic);
    }

    .mode-link:hover {
        border-color: var(--neon-cyan);
        box-shadow: 0 0 30px var(--glow-cyan);
        transform: translateY(-2px);
    }

    .mode-link.purple {
        color: var(--ion-purple);
        border-color: rgba(168, 85, 247, 0.3);
    }

    .mode-link.purple:hover {
        border-color: var(--ion-purple);
        box-shadow: 0 0 30px var(--glow-purple);
    }

    .link-glow {
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(
            90deg,
            transparent,
            rgba(255, 255, 255, 0.1),
            transparent
        );
        transition: left 0.5s ease;
    }

    .mode-link:hover .link-glow {
        left: 100%;
    }

    /* Energy Connector */
    .ops-connector {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 12px;
        padding: 0 12px;
        position: relative;
    }

    .connector-beam {
        width: 2px;
        height: 60px;
        background: linear-gradient(
            to bottom,
            var(--neon-cyan),
            var(--ion-purple)
        );
        border-radius: 1px;
        box-shadow: 0 0 10px var(--glow-cyan);
    }

    .connector-pulse {
        position: absolute;
        width: 8px;
        height: 8px;
        background: white;
        border-radius: 50%;
        box-shadow: 0 0 15px white;
        animation: pulseMove 3s ease-in-out infinite;
    }

    @keyframes pulseMove {
        0%,
        100% {
            top: 30%;
            opacity: 0;
        }
        10% {
            opacity: 1;
        }
        50% {
            top: 70%;
            opacity: 1;
        }
        60% {
            opacity: 0;
        }
    }

    .connector-label {
        font-family: var(--font-mono);
        font-size: 10px;
        letter-spacing: 2px;
        color: var(--text-muted);
        writing-mode: vertical-rl;
        text-orientation: mixed;
    }

    @media (max-width: 768px) {
        .ops-container {
            flex-direction: column;
        }

        .ops-connector {
            flex-direction: row;
            padding: 12px 0;
        }

        .connector-beam {
            width: 60px;
            height: 2px;
            background: linear-gradient(
                to right,
                var(--neon-cyan),
                var(--ion-purple)
            );
        }

        .connector-label {
            writing-mode: horizontal-tb;
        }

        .connector-pulse {
            animation: pulseMoveHorizontal 3s ease-in-out infinite;
        }

        @keyframes pulseMoveHorizontal {
            0%,
            100% {
                left: 30%;
                opacity: 0;
                top: 50%;
            }
            10% {
                opacity: 1;
            }
            50% {
                left: 70%;
                opacity: 1;
            }
            60% {
                opacity: 0;
            }
        }
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const section = document.querySelector(".dual-ops-section");

        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add("visible");
                    }
                });
            },
            { threshold: 0.1 },
        );

        if (section) observer.observe(section);
    });
</script>
