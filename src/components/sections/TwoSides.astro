---
// Two Sides - Developer & Content Creator Showcase
---

<section class="two-sides-section" id="two-sides">
    <div class="section-header">
        <h2 class="section-title">
            <span class="title-icon">⚡</span>
            TWO SIDES
        </h2>
        <p class="section-subtitle">Developer by Day • Creator by Night</p>
    </div>

    <div class="sides-container">
        <!-- Developer Side -->
        <div class="side developer-side">
            <div class="side-glow cyan"></div>
            <div class="side-content">
                <div class="side-icon">
                    <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                    >
                        <polyline points="16,18 22,12 16,6"></polyline>
                        <polyline points="8,6 2,12 8,18"></polyline>
                    </svg>
                </div>
                <h3 class="side-title">DEVELOPER</h3>
                <p class="side-tagline">Building the Future</p>

                <div class="side-stats">
                    <div class="stat-item">
                        <span class="stat-icon">💻</span>
                        <span class="stat-text">Full Stack</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-icon">🧠</span>
                        <span class="stat-text">Problem Solver</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-icon">⚙️</span>
                        <span class="stat-text">System Design</span>
                    </div>
                </div>

                <a
                    href="https://leetcode.com/YOUR_USERNAME"
                    class="side-link"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <svg
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        width="20"
                        height="20"
                    >
                        <path
                            d="M13.483 0a1.374 1.374 0 0 0-.961.438L7.116 6.226l-3.854 4.126a5.266 5.266 0 0 0-1.209 2.104 5.35 5.35 0 0 0-.125.513 5.527 5.527 0 0 0 .062 2.362 5.83 5.83 0 0 0 .349 1.017 5.938 5.938 0 0 0 1.271 1.818l4.277 4.193.039.038c2.248 2.165 5.852 2.133 8.063-.074l2.396-2.392c.54-.54.54-1.414.003-1.955a1.378 1.378 0 0 0-1.951-.003l-2.396 2.392a3.021 3.021 0 0 1-4.205.038l-.02-.019-4.276-4.193c-.652-.64-.972-1.469-.948-2.263a2.68 2.68 0 0 1 .066-.523 2.545 2.545 0 0 1 .619-1.164L9.13 8.114c1.058-1.134 3.204-1.27 4.43-.278l3.501 2.831c.593.48 1.461.387 1.94-.207a1.384 1.384 0 0 0-.207-1.943l-3.5-2.831c-.8-.647-1.766-1.045-2.774-1.202l2.015-2.158A1.384 1.384 0 0 0 13.483 0zm-2.866 12.815a1.38 1.38 0 0 0-1.38 1.382 1.38 1.38 0 0 0 1.38 1.382H20.79a1.38 1.38 0 0 0 1.38-1.382 1.38 1.38 0 0 0-1.38-1.382z"
                        ></path>
                    </svg>
                    View LeetCode
                </a>
            </div>
        </div>

        <!-- Divider -->
        <div class="sides-divider">
            <div class="divider-line"></div>
            <span class="divider-text">×</span>
            <div class="divider-line"></div>
        </div>

        <!-- Creator Side -->
        <div class="side creator-side">
            <div class="side-glow magenta"></div>
            <div class="side-content">
                <div class="side-icon">
                    <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                    >
                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"
                        ></rect>
                        <circle cx="8.5" cy="8.5" r="1.5"></circle>
                        <polyline points="21,15 16,10 5,21"></polyline>
                    </svg>
                </div>
                <h3 class="side-title">CREATOR</h3>
                <p class="side-tagline">Telling Stories</p>

                <div class="side-stats">
                    <div class="stat-item">
                        <span class="stat-icon">📸</span>
                        <span class="stat-text">Content</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-icon">🎬</span>
                        <span class="stat-text">Reels</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-icon">✨</span>
                        <span class="stat-text">Aesthetic</span>
                    </div>
                </div>

                <a
                    href="https://instagram.com/YOUR_HANDLE"
                    class="side-link magenta"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <svg
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        width="20"
                        height="20"
                    >
                        <path
                            d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
                        ></path>
                    </svg>
                    View Instagram
                </a>
            </div>
        </div>
    </div>
</section>

<style>
    .two-sides-section {
        padding: 80px 20px;
        max-width: 1100px;
        margin: 0 auto;
        opacity: 0;
        transform: translateY(30px);
        transition:
            opacity 0.8s ease-out,
            transform 0.8s ease-out;
    }

    .two-sides-section.visible {
        opacity: 1;
        transform: translateY(0);
    }

    .section-header {
        margin-bottom: 50px;
        text-align: center;
    }

    .section-title {
        font-family: var(--font-display);
        font-size: 28px;
        font-weight: 700;
        letter-spacing: 6px;
        color: var(--text-primary);
        display: inline-flex;
        align-items: center;
        gap: 16px;
        padding: 16px 32px;
        background: linear-gradient(
            135deg,
            rgba(0, 240, 255, 0.05),
            rgba(255, 0, 170, 0.05)
        );
        border: 1px solid rgba(0, 240, 255, 0.2);
        border-radius: 10px;
        margin-bottom: 12px;
    }

    .title-icon {
        font-size: 28px;
    }

    .section-subtitle {
        font-family: var(--font-primary);
        font-size: 14px;
        color: var(--text-secondary);
        letter-spacing: 2px;
    }

    .sides-container {
        display: flex;
        align-items: stretch;
        gap: 20px;
    }

    .side {
        flex: 1;
        position: relative;
        background: linear-gradient(
            165deg,
            rgba(8, 8, 18, 0.95) 0%,
            rgba(5, 5, 12, 0.98) 100%
        );
        border-radius: 20px;
        padding: 40px 30px;
        overflow: hidden;
        transition: all 0.4s ease;
    }

    .developer-side {
        border: 1px solid rgba(0, 240, 255, 0.2);
    }

    .creator-side {
        border: 1px solid rgba(255, 0, 170, 0.2);
    }

    .side:hover {
        transform: translateY(-8px);
    }

    .developer-side:hover {
        box-shadow: 0 20px 60px rgba(0, 240, 255, 0.15);
        border-color: rgba(0, 240, 255, 0.4);
    }

    .creator-side:hover {
        box-shadow: 0 20px 60px rgba(255, 0, 170, 0.15);
        border-color: rgba(255, 0, 170, 0.4);
    }

    .side-glow {
        position: absolute;
        top: -50%;
        left: 50%;
        transform: translateX(-50%);
        width: 200px;
        height: 200px;
        border-radius: 50%;
        filter: blur(80px);
        opacity: 0.3;
        pointer-events: none;
    }

    .side-glow.cyan {
        background: var(--neon-cyan);
    }

    .side-glow.magenta {
        background: var(--neon-magenta);
    }

    .side-content {
        position: relative;
        z-index: 1;
        text-align: center;
    }

    .side-icon {
        width: 60px;
        height: 60px;
        margin: 0 auto 20px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .developer-side .side-icon svg {
        width: 50px;
        height: 50px;
        color: var(--neon-cyan);
    }

    .creator-side .side-icon svg {
        width: 50px;
        height: 50px;
        color: var(--neon-magenta);
    }

    .side-title {
        font-family: var(--font-display);
        font-size: 24px;
        font-weight: 700;
        letter-spacing: 4px;
        margin-bottom: 8px;
    }

    .developer-side .side-title {
        color: var(--neon-cyan);
        text-shadow: 0 0 30px rgba(0, 240, 255, 0.5);
    }

    .creator-side .side-title {
        color: var(--neon-magenta);
        text-shadow: 0 0 30px rgba(255, 0, 170, 0.5);
    }

    .side-tagline {
        font-family: var(--font-primary);
        font-size: 14px;
        color: var(--text-secondary);
        margin-bottom: 30px;
    }

    .side-stats {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-bottom: 30px;
    }

    .stat-item {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 10px 20px;
        background: rgba(255, 255, 255, 0.03);
        border-radius: 30px;
    }

    .stat-icon {
        font-size: 18px;
    }

    .stat-text {
        font-family: var(--font-display);
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 2px;
        color: var(--text-secondary);
    }

    .side-link {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 14px 28px;
        font-family: var(--font-display);
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 2px;
        text-decoration: none;
        border-radius: 30px;
        transition: all 0.3s ease;
        background: rgba(0, 240, 255, 0.1);
        border: 1px solid rgba(0, 240, 255, 0.3);
        color: var(--neon-cyan);
    }

    .side-link:hover {
        background: rgba(0, 240, 255, 0.2);
        box-shadow: 0 0 30px rgba(0, 240, 255, 0.3);
        transform: scale(1.05);
    }

    .side-link.magenta {
        background: rgba(255, 0, 170, 0.1);
        border: 1px solid rgba(255, 0, 170, 0.3);
        color: var(--neon-magenta);
    }

    .side-link.magenta:hover {
        background: rgba(255, 0, 170, 0.2);
        box-shadow: 0 0 30px rgba(255, 0, 170, 0.3);
    }

    .sides-divider {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 15px;
        padding: 0 10px;
    }

    .divider-line {
        width: 2px;
        height: 80px;
        background: linear-gradient(
            to bottom,
            transparent,
            rgba(255, 255, 255, 0.2),
            transparent
        );
    }

    .divider-text {
        font-family: var(--font-display);
        font-size: 20px;
        color: var(--text-secondary);
    }

    @media (max-width: 768px) {
        .sides-container {
            flex-direction: column;
        }

        .sides-divider {
            flex-direction: row;
            padding: 20px 0;
        }

        .divider-line {
            width: 80px;
            height: 2px;
            background: linear-gradient(
                to right,
                transparent,
                rgba(255, 255, 255, 0.2),
                transparent
            );
        }

        .side {
            padding: 30px 25px;
        }
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const twoSidesSection = document.querySelector(".two-sides-section");

        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add("visible");
                    }
                });
            },
            { threshold: 0.1 },
        );

        if (twoSidesSection) {
            observer.observe(twoSidesSection);
        }
    });
</script>
