---

<section class="comms-section" id="comms">
    <div class="section-header">
        <div class="header-line"></div>
        <div class="header-content">
            <span class="header-indicator"></span>
            <span class="header-label">COMMS.ARRAY</span>
        </div>
        <div class="header-line"></div>
    </div>

    <h2 class="section-title">Communication Channels</h2>

    <div class="comms-grid">
        {
            socialLinks.map((link) => (
                <a
                    href={link.url}
                    class={`comms-card floating-panel ${link.color}`}
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <div class="card-glow" />
                    <div class="card-header">
                        <span class="status-dot" />
                        <span class="status-text">ONLINE</span>
                    </div>
                    <div class="card-icon">
                        <svg viewBox="0 0 24 24" fill="currentColor">
                            <path d={link.icon} />
                        </svg>
                        <div class="icon-ring" />
                    </div>
                    <span class="card-label">{link.label}</span>
                    <span class="card-action">CONNECT →</span>
                </a>
            ))
        }
    </div>
</section>

<style>
    .comms-section {
        padding: 80px 20px;
        max-width: 1000px;
        margin: 0 auto;
        opacity: 0;
        transform: translateY(30px);
        transition:
            opacity var(--duration-slow) var(--ease-cinematic),
            transform var(--duration-slow) var(--ease-cinematic);
    }

    .comms-section.visible {
        opacity: 1;
        transform: translateY(0);
    }

    .section-header {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 20px;
        margin-bottom: 24px;
    }

    .header-line {
        flex: 1;
        max-width: 120px;
        height: 1px;
        background: linear-gradient(
            90deg,
            transparent,
            var(--border-default),
            transparent
        );
    }

    .header-content {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .header-indicator {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--plasma-green);
        box-shadow: 0 0 12px var(--plasma-green);
        animation: indicatorPulse 2s ease-in-out infinite;
    }

    @keyframes indicatorPulse {
        0%,
        100% {
            opacity: 1;
        }
        50% {
            opacity: 0.5;
        }
    }

    .header-label {
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 2px;
        color: var(--text-muted);
    }

    .section-title {
        font-family: var(--font-display);
        font-size: 32px;
        font-weight: 600;
        letter-spacing: 1px;
        color: var(--text-primary);
        text-align: center;
        margin-bottom: 48px;
    }

    .comms-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
    }

    .comms-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 28px 24px;
        text-decoration: none;
        position: relative;
        overflow: hidden;
        transition: all var(--duration-medium) var(--ease-cinematic);
    }

    .comms-card:hover {
        transform: translateY(-6px);
    }

    .card-glow {
        position: absolute;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 100px;
        height: 100px;
        border-radius: 50%;
        filter: blur(40px);
        opacity: 0;
        transition: opacity var(--duration-medium) ease;
    }

    .comms-card.cyan .card-glow {
        background: var(--neon-cyan);
    }
    .comms-card.purple .card-glow {
        background: var(--ion-purple);
    }
    .comms-card.amber .card-glow {
        background: var(--amber-alert);
    }
    .comms-card.green .card-glow {
        background: var(--plasma-green);
    }

    .comms-card:hover .card-glow {
        opacity: 0.3;
    }

    .card-header {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 20px;
    }

    .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
    }

    .comms-card.cyan .status-dot {
        background: var(--neon-cyan);
        box-shadow: 0 0 8px var(--neon-cyan);
    }
    .comms-card.purple .status-dot {
        background: var(--ion-purple);
        box-shadow: 0 0 8px var(--ion-purple);
    }
    .comms-card.amber .status-dot {
        background: var(--amber-alert);
        box-shadow: 0 0 8px var(--amber-alert);
    }
    .comms-card.green .status-dot {
        background: var(--plasma-green);
        box-shadow: 0 0 8px var(--plasma-green);
    }

    .status-text {
        font-family: var(--font-mono);
        font-size: 9px;
        letter-spacing: 1px;
    }

    .comms-card.cyan .status-text {
        color: var(--neon-cyan);
    }
    .comms-card.purple .status-text {
        color: var(--ion-purple);
    }
    .comms-card.amber .status-text {
        color: var(--amber-alert);
    }
    .comms-card.green .status-text {
        color: var(--plasma-green);
    }

    .card-icon {
        width: 48px;
        height: 48px;
        color: var(--text-secondary);
        position: relative;
        margin-bottom: 16px;
        transition: color var(--duration-fast) ease;
    }

    .comms-card:hover .card-icon {
        color: var(--text-primary);
    }

    .icon-ring {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 70px;
        height: 70px;
        border-radius: 50%;
        border: 1px solid var(--border-default);
        opacity: 0;
        transition: all var(--duration-medium) var(--ease-cinematic);
    }

    .comms-card:hover .icon-ring {
        opacity: 1;
        width: 80px;
        height: 80px;
    }

    .comms-card.cyan:hover .icon-ring {
        border-color: var(--neon-cyan);
    }
    .comms-card.purple:hover .icon-ring {
        border-color: var(--ion-purple);
    }
    .comms-card.amber:hover .icon-ring {
        border-color: var(--amber-alert);
    }
    .comms-card.green:hover .icon-ring {
        border-color: var(--plasma-green);
    }

    .card-label {
        font-family: var(--font-primary);
        font-size: 15px;
        font-weight: 500;
        color: var(--text-primary);
        margin-bottom: 8px;
    }

    .card-action {
        font-family: var(--font-mono);
        font-size: 10px;
        letter-spacing: 1px;
        color: var(--text-muted);
        opacity: 0;
        transform: translateY(8px);
        transition: all var(--duration-medium) var(--ease-cinematic);
    }

    .comms-card:hover .card-action {
        opacity: 1;
        transform: translateY(0);
    }

    .comms-card.cyan:hover .card-action {
        color: var(--neon-cyan);
    }
    .comms-card.purple:hover .card-action {
        color: var(--ion-purple);
    }
    .comms-card.amber:hover .card-action {
        color: var(--amber-alert);
    }
    .comms-card.green:hover .card-action {
        color: var(--plasma-green);
    }

    @media (max-width: 768px) {
        .comms-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .comms-card {
            padding: 24px 20px;
        }
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const section = document.querySelector(".comms-section");

        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add("visible");
                    }
                });
            },
            { threshold: 0.1 },
        );

        if (section) observer.observe(section);
    });
</script>
