<section class="about-section" id="about">
    <div class="section-header">
        <h2 class="section-title">
            <span class="title-icon">📋</span>
            PLAYER BIO
        </h2>
    </div>
    <div class="about-content">
        <div class="about-card">
            <p class="about-text">
                A passionate Full Stack Developer with a keen eye for building
                scalable, performant applications. Known in the dev community as <strong
                    >Crisp</strong
                >, I bring clean code and creative solutions to every project.
                With expertise spanning frontend frameworks to backend
                architecture, I turn complex problems into elegant,
                user-friendly experiences.
            </p>
            <div class="about-highlights">
                <div class="highlight-item">
                    <span class="highlight-icon">🎯</span>
                    <span class="highlight-text">Precision Coder</span>
                </div>
                <div class="highlight-item">
                    <span class="highlight-icon">⚡</span>
                    <span class="highlight-text">Fast Learner</span>
                </div>
                <div class="highlight-item">
                    <span class="highlight-icon">🔥</span>
                    <span class="highlight-text">Problem Solver</span>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    /* About Section */
    .about-section {
        padding: 80px 20px;
        max-width: 900px;
        margin: 0 auto;
        opacity: 0;
        transform: translateY(30px);
        transition:
            opacity 0.8s ease-out,
            transform 0.8s ease-out;
    }

    .about-section.visible {
        opacity: 1;
        transform: translateY(0);
    }

    .section-header {
        margin-bottom: 40px;
        text-align: center;
    }

    .section-title {
        font-family: var(--font-display);
        font-size: 28px;
        font-weight: 700;
        letter-spacing: 6px;
        color: var(--text-primary);
        display: inline-flex;
        align-items: center;
        gap: 16px;
        padding: 16px 32px;
        background: rgba(0, 240, 255, 0.05);
        border: 1px solid rgba(0, 240, 255, 0.2);
        border-radius: 10px;
        box-shadow: 0 0 30px rgba(0, 240, 255, 0.1);
    }

    .title-icon {
        font-size: 28px;
    }

    .about-content {
        position: relative;
    }

    .about-card {
        background: linear-gradient(
            165deg,
            rgba(8, 8, 18, 0.95) 0%,
            rgba(5, 5, 12, 0.98) 50%,
            rgba(8, 12, 15, 0.95) 100%
        );
        border: 1px solid rgba(0, 240, 255, 0.15);
        border-radius: 16px;
        padding: 40px;
        backdrop-filter: blur(20px);
        box-shadow:
            0 10px 40px rgba(0, 0, 0, 0.5),
            0 0 60px rgba(0, 240, 255, 0.05),
            inset 0 1px 0 rgba(255, 255, 255, 0.03);
        position: relative;
        overflow: hidden;
    }

    .about-card::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 1px;
        background: linear-gradient(
            90deg,
            transparent,
            rgba(0, 240, 255, 0.5),
            rgba(255, 0, 170, 0.5),
            transparent
        );
    }

    .about-text {
        font-size: 18px;
        line-height: 1.8;
        color: var(--text-secondary);
        margin-bottom: 30px;
    }

    .about-text strong {
        color: var(--neon-cyan);
        font-weight: 700;
        text-shadow: 0 0 20px rgba(0, 240, 255, 0.3);
    }

    .about-highlights {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 20px;
    }

    .highlight-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 24px;
        background: rgba(0, 240, 255, 0.05);
        border: 1px solid rgba(0, 240, 255, 0.2);
        border-radius: 50px;
        transition: all 0.3s ease;
    }

    .highlight-item:hover {
        background: rgba(0, 240, 255, 0.1);
        transform: translateY(-3px);
        box-shadow:
            0 8px 25px rgba(0, 240, 255, 0.2),
            0 0 30px rgba(255, 0, 170, 0.1);
        border-color: rgba(0, 240, 255, 0.4);
    }

    .highlight-icon {
        font-size: 20px;
    }

    .highlight-text {
        font-family: var(--font-display);
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 2px;
        color: var(--neon-cyan);
    }

    @media (max-width: 768px) {
        .about-card {
            padding: 25px;
        }

        .about-text {
            font-size: 16px;
        }

        .highlight-item {
            padding: 10px 18px;
        }
    }
</style>
