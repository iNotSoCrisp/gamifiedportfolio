---
// Profile Module - Cinematic Floating Panel
---

<section class="profile-section floating-panel" id="profile">
    <div class="panel-header">
        <span class="panel-indicator"></span>
        <span class="panel-label">PROFILE.MODULE</span>
    </div>

    <div class="profile-content">
        <h2 class="profile-title">Operator Profile</h2>
        <p class="profile-text">
            A passionate Full Stack Developer with a keen eye for building
            scalable, performant applications. Known in the dev community as
            <span class="highlight-name">Crisp</span>, I bring clean code and
            creative solutions to every project. With expertise spanning
            frontend frameworks to backend architecture, I turn complex problems
            into elegant, user-friendly experiences.
        </p>

        <div class="profile-stats">
            <div class="stat-module">
                <span class="stat-glow"></span>
                <span class="stat-label">Precision</span>
                <span class="stat-value">OPTIMIZED</span>
            </div>
            <div class="stat-module">
                <span class="stat-glow"></span>
                <span class="stat-label">Learning</span>
                <span class="stat-value">ADAPTIVE</span>
            </div>
            <div class="stat-module">
                <span class="stat-glow"></span>
                <span class="stat-label">Problem Solving</span>
                <span class="stat-value">ACTIVE</span>
            </div>
        </div>
    </div>
</section>

<style>
    .profile-section {
        padding: var(--panel-padding);
        max-width: 900px;
        margin: 80px auto;
        opacity: 0;
        transform: translateY(30px);
        transition:
            opacity var(--duration-slow) var(--ease-cinematic),
            transform var(--duration-slow) var(--ease-cinematic);
    }

    .profile-section.visible {
        opacity: 1;
        transform: translateY(0);
    }

    .panel-header {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 24px;
        padding-bottom: 16px;
        border-bottom: 1px solid var(--border-default);
    }

    .panel-indicator {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--neon-cyan);
        box-shadow: 0 0 12px var(--neon-cyan);
        animation: indicatorPulse 2s ease-in-out infinite;
    }

    @keyframes indicatorPulse {
        0%,
        100% {
            opacity: 1;
            box-shadow: 0 0 12px var(--neon-cyan);
        }
        50% {
            opacity: 0.6;
            box-shadow: 0 0 6px var(--neon-cyan);
        }
    }

    .panel-label {
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 2px;
        color: var(--text-muted);
    }

    .profile-content {
        padding: 8px 0;
    }

    .profile-title {
        font-family: var(--font-display);
        font-size: 28px;
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 20px;
        letter-spacing: 1px;
    }

    .profile-text {
        font-size: 16px;
        line-height: 1.9;
        color: var(--text-secondary);
        margin-bottom: 32px;
    }

    .highlight-name {
        color: var(--neon-cyan);
        font-weight: 600;
        text-shadow: 0 0 20px var(--glow-cyan);
    }

    .profile-stats {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
    }

    .stat-module {
        flex: 1;
        min-width: 140px;
        display: flex;
        flex-direction: column;
        gap: 6px;
        padding: 16px 20px;
        background: rgba(0, 240, 255, 0.03);
        border: 1px solid var(--border-default);
        border-radius: 10px;
        position: relative;
        overflow: hidden;
        transition: all var(--duration-medium) var(--ease-cinematic);
    }

    .stat-module:hover {
        border-color: rgba(0, 240, 255, 0.3);
        background: rgba(0, 240, 255, 0.06);
        transform: translateY(-2px);
    }

    .stat-glow {
        position: absolute;
        top: -20px;
        left: 50%;
        transform: translateX(-50%);
        width: 60px;
        height: 40px;
        background: radial-gradient(
            ellipse,
            var(--glow-cyan) 0%,
            transparent 70%
        );
        opacity: 0;
        transition: opacity var(--duration-medium) ease;
    }

    .stat-module:hover .stat-glow {
        opacity: 0.5;
    }

    .stat-label {
        font-family: var(--font-mono);
        font-size: 10px;
        letter-spacing: 1px;
        color: var(--text-muted);
    }

    .stat-value {
        font-family: var(--font-mono);
        font-size: 13px;
        font-weight: 600;
        color: var(--neon-cyan);
        text-shadow: 0 0 10px var(--glow-cyan);
    }

    @media (max-width: 768px) {
        .profile-section {
            margin: 60px 20px;
        }

        .profile-stats {
            flex-direction: column;
        }

        .stat-module {
            min-width: 100%;
        }
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const section = document.querySelector(".profile-section");

        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add("visible");
                    }
                });
            },
            { threshold: 0.1 },
        );

        if (section) observer.observe(section);
    });
</script>
