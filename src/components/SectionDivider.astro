---
interface Props {
    variant?: "wave" | "mesh" | "geometric";
    flip?: boolean;
}

const { variant = "wave", flip = false } = Astro.props;
---

<div class={`section-divider ${variant} ${flip ? "flipped" : ""}`}>
    <!-- 3D Perspective Container -->
    <div class="divider-3d">
        <!-- Animated Wave Line -->
        <svg class="wave-svg" viewBox="0 0 1440 120" preserveAspectRatio="none">
            <defs>
                <linearGradient
                    id="waveGradient"
                    x1="0%"
                    y1="0%"
                    x2="100%"
                    y2="0%"
                >
                    <stop
                        offset="0%"
                        style="stop-color:#00f0ff;stop-opacity:0.8"></stop>
                    <stop
                        offset="50%"
                        style="stop-color:#ff00aa;stop-opacity:0.6"></stop>
                    <stop
                        offset="100%"
                        style="stop-color:#00f0ff;stop-opacity:0.8"></stop>
                </linearGradient>
                <filter id="glow">
                    <feGaussianBlur stdDeviation="3" result="coloredBlur"
                    ></feGaussianBlur>
                    <feMerge>
                        <feMergeNode in="coloredBlur"></feMergeNode>
                        <feMergeNode in="SourceGraphic"></feMergeNode>
                    </feMerge>
                </filter>
            </defs>
            <path
                class="wave-path"
                fill="none"
                stroke="url(#waveGradient)"
                stroke-width="2"
                filter="url(#glow)"
                d="M0,60 C240,120 480,0 720,60 C960,120 1200,0 1440,60"></path>
            <path
                class="wave-path delayed"
                fill="none"
                stroke="url(#waveGradient)"
                stroke-width="1"
                opacity="0.4"
                d="M0,70 C240,130 480,10 720,70 C960,130 1200,10 1440,70"
            ></path>
        </svg>

        <!-- Floating Geometric Shapes -->
        <div class="floating-shapes">
            <div class="shape diamond"></div>
            <div class="shape hexagon"></div>
            <div class="shape triangle"></div>
            <div class="shape circle"></div>
        </div>

        <!-- Horizontal Glow Line -->
        <div class="glow-line"></div>
    </div>
</div>

<style>
    .section-divider {
        position: relative;
        width: 100%;
        height: 120px;
        overflow: visible;
        z-index: 10;
    }

    .section-divider.flipped {
        transform: scaleY(-1);
    }

    .divider-3d {
        position: relative;
        width: 100%;
        height: 100%;
        transform-style: preserve-3d;
        perspective: 1000px;
    }

    /* Animated Wave SVG */
    .wave-svg {
        position: absolute;
        width: 200%;
        height: 100%;
        left: -50%;
        animation: waveScroll 20s linear infinite;
    }

    .wave-path {
        stroke-dasharray: 1440;
        stroke-dashoffset: 0;
        animation: wavePulse 4s ease-in-out infinite;
    }

    .wave-path.delayed {
        animation-delay: 0.5s;
    }

    @keyframes waveScroll {
        0% {
            transform: translateX(0);
        }
        100% {
            transform: translateX(50%);
        }
    }

    @keyframes wavePulse {
        0%,
        100% {
            opacity: 0.6;
            stroke-width: 2;
        }
        50% {
            opacity: 1;
            stroke-width: 3;
        }
    }

    /* Floating Geometric Shapes */
    .floating-shapes {
        position: absolute;
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        pointer-events: none;
    }

    .shape {
        position: absolute;
        border: 1px solid rgba(0, 240, 255, 0.3);
        animation: floatRotate 8s ease-in-out infinite;
    }

    .diamond {
        width: 20px;
        height: 20px;
        left: 15%;
        top: 20%;
        transform: rotate(45deg);
        animation-delay: 0s;
    }

    .hexagon {
        width: 24px;
        height: 24px;
        left: 40%;
        top: 60%;
        clip-path: polygon(
            50% 0%,
            100% 25%,
            100% 75%,
            50% 100%,
            0% 75%,
            0% 25%
        );
        background: transparent;
        border: none;
        box-shadow: inset 0 0 0 1px rgba(255, 0, 170, 0.4);
        animation-delay: 2s;
    }

    .triangle {
        width: 0;
        height: 0;
        left: 65%;
        top: 30%;
        border-left: 10px solid transparent;
        border-right: 10px solid transparent;
        border-bottom: 18px solid rgba(0, 240, 255, 0.3);
        background: transparent;
        border-top: none;
        animation-delay: 1s;
    }

    .circle {
        width: 16px;
        height: 16px;
        right: 20%;
        top: 50%;
        border-radius: 50%;
        border-color: rgba(255, 0, 170, 0.4);
        animation-delay: 3s;
    }

    @keyframes floatRotate {
        0%,
        100% {
            transform: translateY(0) rotate(0deg);
            opacity: 0.4;
        }
        50% {
            transform: translateY(-15px) rotate(180deg);
            opacity: 0.8;
        }
    }

    /* Glow Line */
    .glow-line {
        position: absolute;
        width: 100%;
        height: 2px;
        top: 50%;
        left: 0;
        background: linear-gradient(
            90deg,
            transparent 0%,
            rgba(0, 240, 255, 0.6) 20%,
            rgba(255, 0, 170, 0.6) 50%,
            rgba(0, 240, 255, 0.6) 80%,
            transparent 100%
        );
        box-shadow:
            0 0 20px rgba(0, 240, 255, 0.5),
            0 0 40px rgba(255, 0, 170, 0.3);
        animation: lineGlow 3s ease-in-out infinite;
    }

    @keyframes lineGlow {
        0%,
        100% {
            opacity: 0.5;
        }
        50% {
            opacity: 1;
        }
    }

    /* Responsive */
    @media (max-width: 768px) {
        .section-divider {
            height: 80px;
        }

        .shape {
            display: none;
        }
    }

    /* Reduced motion */
    @media (prefers-reduced-motion: reduce) {
        .wave-svg,
        .shape,
        .wave-path,
        .glow-line {
            animation: none;
        }
    }
</style>
