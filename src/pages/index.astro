---
import Layout from "../layouts/Layout.astro";
import App from "../components/App";
import Navigation from "../components/Navigation.astro";
import About from "../components/sections/About.astro";
import Skills from "../components/sections/Skills.astro";
import TwoSides from "../components/sections/TwoSides.astro";
import Social from "../components/sections/Social.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="CRISP | Developer & Content Creator">
    <!-- FIFA Pack Opening - Now loads directly -->
    <App client:load />

    <!-- Static sections (hidden initially, shown after scroll) -->
    <div class="static-sections" id="staticSections">
        <Navigation />
        <About />
        <Skills />
        <TwoSides />
        <Social />
        <Footer />
    </div>
</Layout>

<style is:global>
    .static-sections {
        display: none;
        background: var(--bg-primary);
    }

    .static-sections.visible {
        display: block;
    }
</style>
