---
import Layout from "../layouts/Layout.astro";
import App from "../components/App";
---

<Layout title="SIMULATION.MODE | Legacy Archive">
    <!-- FIFA Pack Opening Animation - Preserved Legacy Module -->
    <App client:load />

    <!-- Back to main site link -->
    <a href="/" class="back-link" id="backLink">
        <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            width="16"
            height="16"
        >
            <path d="M19 12H5M12 19l-7-7 7-7"></path>
        </svg>
        <span>EXIT SIMULATION</span>
    </a>
</Layout>

<style>
    .back-link {
        position: fixed;
        top: 20px;
        left: 20px;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 16px;
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 1px;
        color: var(--text-secondary);
        text-decoration: none;
        background: rgba(30, 41, 59, 0.8);
        border: 1px solid var(--border-default);
        border-radius: 6px;
        backdrop-filter: blur(10px);
        transition: all 0.3s ease;
        z-index: 1000;
        opacity: 0;
        animation: fadeIn 0.5s ease 3s forwards;
    }

    .back-link:hover {
        color: var(--accent-green);
        border-color: var(--accent-green);
        box-shadow: 0 0 20px var(--glow-green);
    }

    @keyframes fadeIn {
        to {
            opacity: 1;
        }
    }
</style>
